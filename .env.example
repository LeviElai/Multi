# Export these values in the local API terminal.
PORT=4001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3005
PIN_PEPPER=replace-with-a-random-secret-at-least-32-characters
SQLITE_PATH=.sites-runtime/local.sqlite
AUTO_MIGRATE=1

# Frontend terminal / Vercel server-side proxy
GAME_SERVICE_URL=http://127.0.0.1:4001

# Production retains its existing private PostgreSQL configuration on Render.
# DATABASE_URL, TLS settings and GEMINI_API_KEY stay server-only.
# Never prefix credentials with NEXT_PUBLIC_.
GEMINI_MODEL=gemini-3.5-flash-lite
ADS_APPROVED=0
ADS_CONSENT_READY=0
